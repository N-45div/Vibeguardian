{
  "name": "vibeguardian-companion",
  "version": "0.1.0",
  "description": "Tray companion: notices when you copy a Google API key, tells you if it is live, and retires it with proof.",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node --test \"test/**/*.test.js\"",
    "icons": "python scripts/make_icons.py",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.vibeguardian.companion",
    "productName": "VibeGuardian",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "src/**",
      "assets/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/app.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "VibeGuardian-Setup-${version}.exe"
    }
  }
}
